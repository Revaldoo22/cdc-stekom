# Salin ke .env.local lalu isi sesuai kebutuhan: cp .env.example .env.local
# JANGAN commit .env.local — file itu berisi kredensial asli.

# ─── Wajib ────────────────────────────────────────────────────────────────────

# API key CDC (header X-API-Key) untuk semua endpoint https://cdc.stekom.ac.id/api/*
# Server-side only — jangan pernah diberi prefix NEXT_PUBLIC_.
# Aplikasi akan error saat request kalau ini kosong (sengaja, biar ketahuan).
# PENTING: pakai key khusus production, jangan reuse key dev.
CDC_API_KEY=

# API key Virtual Job Fair (host & key berbeda dari API CDC di atas).
VJF_API_KEY=

# ─── Opsional ─────────────────────────────────────────────────────────────────

# Base URL API CDC. Default: https://cdc.stekom.ac.id/api
# CDC_API_BASE=

# Endpoint Virtual Job Fair. Default: https://toploker.com/curl/virtual_jobfair
# VJF_API_URL=

# URL situs (untuk SEO, sitemap, canonical, OG image)
NEXT_PUBLIC_SITE_URL=https://cdc.stekom.ac.id

# Webhook Google Apps Script untuk submit form (lamaran & event)
GOOGLE_SHEET_WEBHOOK_URL=

# Kode verifikasi Google Search Console (metode "HTML tag").
# Ambil HANYA nilai content="..."-nya, bukan seluruh tag <meta>.
# Contoh: dari <meta name="google-site-verification" content="AbC123xyz" />
#         isi  NEXT_PUBLIC_GSC_VERIFICATION=AbC123xyz
# Kalau kosong, tag-nya tidak dirender sama sekali.
NEXT_PUBLIC_GSC_VERIFICATION=

# Paksa data mock (true) atau pakai API CDC live (false)
USE_MOCK=false
